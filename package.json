{
  "name": "tracks-server",
  "module": "index.ts",
  "type": "module",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate",
    "db:init": "node dist/config/db.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.18.0",
    "pgtools": "^1.0.1"
  }
}
